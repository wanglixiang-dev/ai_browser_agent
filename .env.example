# Copy this file to .env, then add your own DeepSeek API key.
# Note: .env is listed in .gitignore. Do not upload real secrets.

DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: the default model is the faster and cheaper deepseek-v4-flash.
# For stronger output quality, change it to deepseek-v4-pro.
DEEPSEEK_MODEL=deepseek-v4-flash
